# Kopioi tämä .env.example -> .env paikallista kehitystä varten (npx netlify dev).
# Netlifyyn samat arvot lisätään: Site configuration > Environment variables.

# --- Cloudflare R2 ---
# Account ID löytyy Cloudflare R2 -etusivulta (tai S3-endpointista https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens > Create API token (Object Read & Write, tietty bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Esim. nordic-kiila-liitteet
R2_BUCKET_NAME=
# Valinnainen: S3-endpoint. Käytä dashboardissa bucketin alla näkyvää tarkkaa
# S3 API -osoitetta ja pudota siitä bucketin nimi pois (pelkkä origin riittää).
# Esim. https://<ACCOUNT_ID>.<JURISDICTION>.r2.cloudflarestorage.com
# Jos jätetään tyhjäksi, käytetään EU-endpointia. Huom: erillinen API-token-arvo
# ("Use this token for authenticating against the Cloudflare API") ei ole
# käytössä — S3-kirjastot käyttävät Access Key ID:tä ja Secret Access Keytä.
R2_S3_ENDPOINT=

# --- Resend ---
# Resend > API Keys > Create API Key
RESEND_API_KEY=

# --- Sähköposti ---
# Mihin osoitteeseen ilmoitukset lähetetään (esim. myynti@nordickiila.fi)
NOTIFY_EMAIL=
# Lähettäjäosoite. Saa olla mikä tahansa Resendissä verifioidun domainin alla.
# Huom: asiakkaan Resendissä verifioitu domain on nordickiila.fi (ilman väliviivaa).
FROM_EMAIL=lomake@nordickiila.fi
