# Kopioi tämä .env.example -> .env paikallista kehitystä varten (npx netlify dev).
# Netlifyyn samat arvot lisätään: Site configuration > Environment variables.

# --- Cloudflare R2 ---
# Account ID: Cloudflare > R2 -etusivu, oikean laidan "Account ID".
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens > Create API token (Object Read & Write, tietty bucket).
# Käytä tokenin "Access Key ID" + "Secret Access Key" -arvoja. Tokenin erillinen
# arvo "Use this token for authenticating against the Cloudflare API" EI ole käytössä.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Esim. nordic-kiila-liitteet
R2_BUCKET_NAME=

# R2_S3_ENDPOINT (valinnainen): R2:n S3-rajapinnan osoite liitteiden tallennukseen.
# - Normaali bucket (ei erillistä sijaintia / "jurisdictionia"): jätä TYHJÄKSI.
#   Sovellus muodostaa osoitteen automaattisesti muodossa
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# - Bucket EU-sijainnissa: aseta tähän https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# Tarkan arvon näet: Cloudflare > R2 > bucket > Settings > S3 API.
# Käytä osoitetta ILMAN bucketin nimeä ja ilman perässä olevaa polkua.
R2_S3_ENDPOINT=

# --- Resend ---
# Resend > API Keys > Create API Key
RESEND_API_KEY=

# --- Sähköposti ---
# Mihin osoitteeseen ilmoitukset lähetetään (esim. myynti@nordickiila.fi)
NOTIFY_EMAIL=
# Lähettäjäosoite. Saa olla mikä tahansa Resendissä verifioidun domainin alla.
# Huom: asiakkaan Resendissä verifioitu domain on nordickiila.fi (ilman väliviivaa).
FROM_EMAIL=lomake@nordickiila.fi
