# Netlify deploy widget (Sanity Studio Dashboard)
# Copy this file to .env and fill in the values. Never commit .env.
# apiId: Netlify → Site configuration → General → Site details → Site information → API ID
SANITY_STUDIO_NETLIFY_API_ID=
# buildHookId: last segment of the build hook URL (https://api.netlify.com/build_hooks/<this-part>)
SANITY_STUDIO_NETLIFY_BUILD_HOOK_ID=
# name: Netlify site name
SANITY_STUDIO_NETLIFY_SITE_NAME=
