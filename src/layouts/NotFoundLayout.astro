---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const { 
  title = "Sivua ei löytynyt | Nordic Kiila", 
  description = "Hakemaasi sivua ei valitettavasti löytynyt." 
} = Astro.props;
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="text-[1rem] text-main font-main font-normal bg-white flex flex-col min-h-screen">
    <Nav />
    <main class="flex-grow w-full max-w-[1400px] mx-auto px-4 py-20 flex flex-col items-center justify-center text-center">
      <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
      <p class="text-xl text-gray-600 mb-8">Hakemaasi sivua ei valitettavasti löytynyt.</p>
      <a href="/" class="btn-primary">Palaa etusivulle</a>
    </main>
    <Footer />
  </body>
</html>