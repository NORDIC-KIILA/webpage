---
import { client, urlFor } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductTable from "../../components/ProductTable.astro";

export async function getStaticPaths() {
  const products =
    await client.fetch(`*[_type == "product" && isHidden != true && defined(slug.current)]{
    "slug": slug.current
  }`);

  return products.map((product: any) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const product = await client.fetch(
  `*[_type == "product" && slug.current == $slug && isHidden != true][0]{
  title,
  measurements,
  summary,
  quickinfo,
  "slug": slug.current,
  category->{ title, "slug": slug.current },
  gallery {
    images[] {
      "url": image.asset->url,
      "alt": alt
    }
  },
  table {
    headers,
    rows[] { cells }
  },
  documents[] {
    title,
    "fileUrl": file.asset->url,
  },
  seo {
    title,
    description,
    "imageUrl": image.asset->url,
    noIndex,
    canonicalUrl,
    breadcrumbs[] { title, url }
  }
}`,
  { slug },
);

if (!product) {
  return Astro.redirect("/404");
}

const siteUrl = "https://nordickiila.fi";
const pageTitle = product.seo?.title || `${product.title} | Nordic Kiila`;
const pageDescription =
  product.seo?.description ||
  "Nordic Kiila - Asiantuntevat vesikaton ratkaisut";
const mainImage = product.gallery?.images?.[0]?.url;
const pageImage =
  product.seo?.imageUrl || mainImage || `${siteUrl}/default-og-image.jpg`;
const canonical =
  product.seo?.canonicalUrl || `${siteUrl}/tuotteet/${product.slug}`;
const robotsContent = product.seo?.noIndex
  ? "noindex, nofollow"
  : "index, follow";

const breadcrumbs = product.seo?.breadcrumbs || [
  { title: "Etusivu", url: "/" },
  {
    title: product.category?.title || "Tuotteet",
    url: product.category
      ? `/kategoria/${product.category.slug}`
      : "/kategoria",
  },
  { title: product.title, url: `/tuotteet/${product.slug}` },
];

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    item: `${siteUrl}${item.url || ""}`,
  })),
};

const thumbnailImages = product.gallery?.images?.slice(1) || [];

// Tab buttons
const btnActiveClass =
  "tab-btn relative border-dark text-white bg-dark whitespace-nowrap py-3 px-5 border font-medium text-base cursor-pointer hover:shadow-md hover:shadow-gray-300 transition-shadow duration-200";
const btnInactiveClass =
  "tab-btn relative border-dark text-dark bg-light whitespace-nowrap py-3 px-5 border font-medium text-base cursor-pointer hover:shadow-md hover:shadow-gray-300 transition-shadow duration-200";
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:url" content={canonical} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdBreadcrumbs)}
    />
  </Fragment>

  <main class="main main-padding">
    <Breadcrumb items={breadcrumbs} className="mb-8" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <!-- Gallery -->
      <div class="space-y-4">
        {
          mainImage ? (
            <a
              href={mainImage}
              data-fslightbox="product-gallery"
              data-type="image"
              class="block aspect-video w-full overflow-hidden border border-gray-200 bg-gray-100"
            >
              <img
                src={mainImage}
                alt={product.gallery.images[0].alt || product.title}
                class="w-full h-full object-cover cursor-zoom-in hover:opacity-90 transition-opacity"
              />
            </a>
          ) : (
            <div class="aspect-video w-full overflow-hidden border border-gray-200 bg-light flex flex-col items-center justify-center text-gray-400">
              <svg
                class="w-16 h-16 mb-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              <span class="text-lg font-medium">Ei kuvaa</span>
            </div>
          )
        }
        {
          thumbnailImages.length > 0 && (
            <div class="grid grid-cols-4 gap-4">
              {thumbnailImages.map((img: any) => (
                <a
                  href={img.url}
                  data-fslightbox="product-gallery"
                  data-type="image"
                  class="block aspect-square overflow-hidden border border-gray-200 bg-gray-100 cursor-zoom-in hover:opacity-80 transition-opacity"
                >
                  <img
                    src={img.url}
                    alt={img.alt || product.title}
                    class="w-full h-full object-cover"
                  />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <!-- Product Info -->
      <div class="space-y-6">
        <div>
          {
            product.category && (
              <a
                href={`/kategoria/${product.category.slug}`}
                class="font-normal text-lg text-dark hover:underline inline-block"
              >
                {product.category.title}
              </a>
            )
          }
          <h1 class="h1">
            {product.title}
          </h1>
          {
            product.measurements && (
              <p class="text-xl text-gray-600 mt-2 font-medium">
                {product.measurements}
              </p>
            )
          }
        </div>

        {
          product.summary && (
            <div class="prose prose-lg max-w-none text-main">
              <PortableText value={product.summary} />
            </div>
          )
        }

        {
          product.quickinfo && (
            <div class="bg-light p-6 border border-dark">
              <h3 class="text-lg font-semibold text-gray-900 mb-3 hidden">
                Pikatiedot
              </h3>
              <div class="prose prose-sm max-w-none text-dark">
                <PortableText value={product.quickinfo} />
              </div>
            </div>
          )
        }

        <a
          href={`/yhteystiedot?${product.category.slug}=${product.slug}`}
          class="btn-primary mt-3 md:mt-5 text-center md:text-left"
          >Pyydä kohdekohtainen suunnitelma ja tarjous</a
        >
      </div>
    </div>

    <!-- Tabs: Technical Table & Documents -->
    <section id="product-tabs">
      <!-- Tab Buttons -->
      <div class="mb-8">
        <nav class="-mb-px flex space-x-4" aria-label="Tabs">
          <button
            type="button"
            class={btnActiveClass}
            aria-current="page"
            data-target="panel-table"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="arrow h-9 w-9 absolute -bottom-5.5 left-1/2 -translate-x-1/2 text-dark"
              fill="currentColor"
              aria-hidden="true"
              viewBox="0 0 256 256"
              ><path
                d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,48,88H208a8,8,0,0,1,5.66,13.66Z"
              ></path></svg
            >
            Tekniset tiedot
          </button>

          {
            product.documents && product.documents.length > 0 && (
              <button
                type="button"
                class={btnInactiveClass}
                data-target="panel-documents"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="arrow h-9 w-9 absolute -bottom-5.5 left-1/2 -translate-x-1/2 text-dark hidden"
                  fill="currentColor"
                  aria-hidden="true"
                  viewBox="0 0 256 256"
                >
                  <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,48,88H208a8,8,0,0,1,5.66,13.66Z" />
                </svg>
                Dokumentit
              </button>
            )
          }
        </nav>
      </div>

      <!-- Tab Panels -->
      <div id="panel-table" class="tab-panel">
        <ProductTable
          headers={product.table?.headers}
          rows={product.table?.rows}
        />
      </div>

      {
        product.documents && product.documents.length > 0 && (
          <div id="panel-documents" class="tab-panel hidden">
            <ul class="space-y-3 max-w-3xl">
              {product.documents.map((doc: any) => (
                <li>
                  <a
                    href={doc.fileUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-4 bg-white border border-gray-200 hover:bg-gray-50 hover:border-accent transition-colors group"
                  >
                    <svg
                      class="w-6 h-6 text-accent shrink-0"
                      fill="none"
                      aria-hidden="true"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                      />
                    </svg>
                    <p class="font-medium text-main group-hover:text-dark transition-colors">
                      <span class="sr-only">Lataa tiedosto:</span>
                      {doc.title}
                    </p>
                    <svg
                      class="w-4 h-4 text-gray-400 ml-auto group-hover:text-dark-green"
                      fill="none"
                      aria-hidden="true"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                      />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <script is:inline src="/fslightbox/fslightbox.js"></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // Force fsLightbox to scan the DOM for data-fslightbox attributes
        if (typeof refreshFsLightbox === "function") {
          refreshFsLightbox();
        }

        // Enable thumbnails on mount if instances exist
        if (typeof fsLightboxInstances !== "undefined") {
          Object.keys(fsLightboxInstances).forEach(function (key) {
            fsLightboxInstances[key].props.showThumbsOnMount = true;
          });
        }
      });
    </script>

    <script is:inline define:vars={{ btnActiveClass, btnInactiveClass }}>
      const tabButtons = document.querySelectorAll(".tab-btn");
      const tabPanels = document.querySelectorAll(".tab-panel");

      const btnActiveClasses = btnActiveClass.split(" ");
      const btnInactiveClasses = btnInactiveClass.split(" ");

      tabButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetId = button.getAttribute("data-target");

          tabButtons.forEach((btn) => {
            btnActiveClasses.forEach((cls) => btn.classList.remove(cls));
            btnInactiveClasses.forEach((cls) => btn.classList.add(cls));
            btn.removeAttribute("aria-current");
            const arrow = btn.querySelector(".arrow");
            if (arrow) arrow.classList.add("hidden");
          });

          btnInactiveClasses.forEach((cls) => button.classList.remove(cls));
          btnActiveClasses.forEach((cls) => button.classList.add(cls));
          button.setAttribute("aria-current", "page");
          const arrow = button.querySelector(".arrow");
          if (arrow) arrow.classList.remove("hidden");

          tabPanels.forEach((panel) => {
            panel.classList.add("hidden");
          });

          const targetPanel = document.getElementById(targetId);
          if (targetPanel) {
            targetPanel.classList.remove("hidden");
          }
        });
      });
    </script>
  </main>
</Layout>
