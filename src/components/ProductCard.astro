---
export interface Props {
  product: {
    title: string;
    slug: string;
    measurements?: string;
    mainImage?: string;
    altText?: string;
  };
}

const { product } = Astro.props;
---

<a
  href={`/tuotteet/${product.slug}`}
  class="group block h-full bg-white border border-gray-200 overflow-hidden hover:shadow-lg hover:border-gray-300 transition-all duration-200"
>
  <div class="aspect-4/3 bg-gray-100 overflow-hidden relative">
    {
      product.mainImage ? (
        <img
          src={product.mainImage}
          alt={product.altText || product.title}
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center text-gray-400 bg-gray-100">
          <svg
            class="w-12 h-12 mb-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
          <span class="text-sm font-medium">Ei kuvaa</span>
        </div>
      )
    }
  </div>
  <div class="p-5">
    <h3 class="text-lg font-semibold text-dark mb-2">
      {product.title}
    </h3>
    {
      product.measurements && (
        <p class="text-sm text-gray-600 line-clamp-2">{product.measurements}</p>
      )
    }
  </div>
</a>
