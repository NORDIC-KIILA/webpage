---
import { client } from "../lib/sanity";

const categories =
  await client.fetch(`*[_type == "category" && isHidden != true && defined(slug.current) && slug.current != "outlet"]{
  title,
  "slug": slug.current
} | order(title asc)`);

const showOutlet = await client.fetch(
  `count(*[_type == "category" && slug.current == "outlet" && isHidden != true]) > 0`,
);

const link = "hover:text-accent duration-200";
---

<nav class="bg-dark text-white">
  <div
    class="mx-auto max-w-[1400px] flex flex-row items-center justify-between p-2 px-4"
  >
    <div>
      <a href="/" class="font-heading uppercase text-[2.8rem] font-bold"
        >Nordic Kiila</a
      >
    </div>

    <!-- Burger button (visible < lg) -->
    <button
      type="button"
      class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 cursor-pointer focus:outline-none focus:text-accent"
      id="burger-button"
      aria-label="Avaa valikko"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="block w-6 h-0.5 bg-current transition-transform duration-300 origin-center"
        id="burger-line-1"></span>
      <span
        class="block w-6 h-0.5 bg-current transition-opacity duration-300"
        id="burger-line-2"></span>
      <span
        class="block w-6 h-0.5 bg-current transition-transform duration-300 origin-center"
        id="burger-line-3"></span>
    </button>

    <!-- Desktop nav (visible >= lg) -->
    <div
      class="hidden lg:flex flex-row gap-10 items-center justify-end font-medium"
    >
      <a href="/" class={link}>Etusivu</a>

      <div class="relative" id="dropdown-container">
        <button
          type="button"
          class="flex items-center gap-1 hover:text-accent focus:outline-none focus:text-accent transition-colors cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="tuotteet-menu"
          id="tuotteet-menu-button"
        >
          Tuotteet
          <svg
            class="w-4 h-4 transition-transform duration-200"
            id="dropdown-chevron"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          class="absolute left-0 mt-4 w-64 bg-white text-dark shadow-xl opacity-0 invisible transition-all duration-200 z-50"
          role="menu"
          aria-labelledby="tuotteet-menu-button"
          id="tuotteet-menu"
        >
          <ul class="py-2">
            <li>
              <a
                href="/kaikki-tuotteet"
                class="hidden px-4 py-2.5 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none transition-colors"
                role="menuitem"
                tabindex="-1"
              >
                Kaikki tuotteet
              </a>
            </li>
            {
              categories.map((cat: any) => (
                <li>
                  <a
                    href={`/kategoria/${cat.slug}`}
                    class="block px-4 py-2.5 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none transition-colors"
                    role="menuitem"
                    tabindex="-1"
                  >
                    {cat.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {showOutlet && <a href="/kategoria/outlet" class={link}>Outlet</a>}
      <a href="/#suunnittelupalvelu" class={link}>Suunnittelupalvelu</a>
      <a href="/yhteystiedot" class="btn-primary">Ota yhteyttä</a>
    </div>
  </div>

  <!-- Mobile backdrop -->
  <div
    class="lg:hidden fixed inset-0 bg-black/60 z-40 opacity-0 invisible transition-opacity duration-300"
    id="mobile-backdrop"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile side drawer -->
  <aside
    id="mobile-menu"
    class="lg:hidden fixed text-[1.15rem] inset-y-0 left-0 w-[85%] max-w-sm bg-dark z-50 -translate-x-full transition-transform duration-300 flex flex-col overflow-y-auto overscroll-contain"
    aria-hidden="true"
    aria-label="Navigaatio"
  >
    <div class="flex items-center justify-between p-4 border-b border-white/10">
      <a href="/" class="font-heading uppercase text-[2.5rem] font-bold"
        >Nordic Kiila</a
      >
      <button
        type="button"
        id="mobile-close"
        class="text-white cursor-pointer focus:outline-none focus:text-accent p-1"
        aria-label="Sulje valikko"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="px-4 py-4 flex flex-col gap-1 font-medium">
      <a
        href="/"
        class="block py-3 px-2 hover:text-accent focus:outline-none focus:text-accent transition-colors"
        >Etusivu</a
      >

      <span class="pt-4 pb-2 px-2 uppercase tracking-wider text-white/50"
        >Tuotteet</span
      >
      <a
        href="/kaikki-tuotteet"
        class="hidden py-2.5 px-2 pl-4 hover:text-accent focus:outline-none focus:text-accent transition-colors"
      >
        Kaikki tuotteet
      </a>
      {
        categories.map((cat: any) => (
          <a
            href={`/kategoria/${cat.slug}`}
            class="block py-2.5 px-2 pl-4 hover:text-accent focus:outline-none focus:text-accent transition-colors"
          >
            {cat.title}
          </a>
        ))
      }

      {
        showOutlet && (
          <a
            href="/kategoria/outlet"
            class="block py-3 px-2 mt-4 hover:text-accent focus:outline-none focus:text-accent transition-colors"
          >
            Outlet
          </a>
        )
      }
      <a
        href="/#suunnittelupalvelu"
        class="block py-3 px-2 hover:text-accent focus:outline-none focus:text-accent transition-colors"
        >Suunnittelupalvelu</a
      >
      <a href="/yhteystiedot" class="btn-primary inline-block text-center mt-4"
        >Ota yhteyttä</a
      >
    </nav>
  </aside>

  <div class="h-3 bg-accent w-full"></div>
</nav>

<script>
  const container = document.getElementById("dropdown-container");
  const button = document.getElementById("tuotteet-menu-button");
  const menu = document.getElementById("tuotteet-menu");
  const chevron = document.getElementById("dropdown-chevron");
  const menuItems = menu.querySelectorAll('[role="menuitem"]');

  function setDropdownOpen(isOpen: boolean) {
    button.setAttribute("aria-expanded", String(isOpen));
    if (isOpen) {
      menu.classList.remove("opacity-0", "invisible");
      menu.classList.add("opacity-100", "visible");
      chevron.classList.add("rotate-180");
    } else {
      menu.classList.add("opacity-0", "invisible");
      menu.classList.remove("opacity-100", "visible");
      chevron.classList.remove("rotate-180");
    }
  }

  function focusItemAt(index: number) {
    if (menuItems[index]) (menuItems[index] as HTMLElement).focus();
  }

  button.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = button.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      setDropdownOpen(false);
    } else {
      setDropdownOpen(true);
      focusItemAt(0);
    }
  });

  button.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      setDropdownOpen(true);
      focusItemAt(0);
    }
  });

  menu.addEventListener("keydown", (e) => {
    const items = Array.from(menuItems) as HTMLElement[];
    const current = items.indexOf(document.activeElement as HTMLElement);

    if (e.key === "ArrowDown") {
      e.preventDefault();
      focusItemAt((current + 1) % items.length);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      focusItemAt((current - 1 + items.length) % items.length);
    } else if (e.key === "Home") {
      e.preventDefault();
      focusItemAt(0);
    } else if (e.key === "End") {
      e.preventDefault();
      focusItemAt(items.length - 1);
    } else if (e.key === "Tab") {
      setDropdownOpen(false);
    }
  });

  document.addEventListener("click", (e) => {
    if (!container.contains(e.target as Node)) {
      setDropdownOpen(false);
    }
  });

  const mobileButton = document.getElementById("burger-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileBackdrop = document.getElementById("mobile-backdrop");
  const mobileClose = document.getElementById("mobile-close");
  const line1 = document.getElementById("burger-line-1");
  const line2 = document.getElementById("burger-line-2");
  const line3 = document.getElementById("burger-line-3");

  function setMobileOpen(isOpen: boolean) {
    mobileButton.setAttribute("aria-expanded", String(isOpen));
    mobileButton.setAttribute(
      "aria-label",
      isOpen ? "Sulje valikko" : "Avaa valikko",
    );
    mobileMenu.setAttribute("aria-hidden", String(isOpen ? "false" : "true"));
    mobileBackdrop.setAttribute(
      "aria-hidden",
      String(isOpen ? "false" : "true"),
    );

    if (isOpen) {
      mobileMenu.classList.remove("-translate-x-full");
      mobileBackdrop.classList.remove("opacity-0", "invisible");
      mobileBackdrop.classList.add("opacity-100", "visible");
      line1.classList.add("translate-y-2", "rotate-45");
      line2.classList.add("opacity-0");
      line3.classList.add("-translate-y-2", "-rotate-45");
      document.body.style.overflow = "hidden";
    } else {
      mobileMenu.classList.add("-translate-x-full");
      mobileBackdrop.classList.add("opacity-0", "invisible");
      mobileBackdrop.classList.remove("opacity-100", "visible");
      line1.classList.remove("translate-y-2", "rotate-45");
      line2.classList.remove("opacity-0");
      line3.classList.remove("-translate-y-2", "-rotate-45");
      document.body.style.overflow = "";
    }
  }

  mobileButton.addEventListener("click", () => {
    const isOpen = mobileButton.getAttribute("aria-expanded") === "true";
    setMobileOpen(!isOpen);
  });

  mobileClose.addEventListener("click", () => setMobileOpen(false));
  mobileBackdrop.addEventListener("click", () => setMobileOpen(false));

  const mobileLinks = mobileMenu.querySelectorAll("a");
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMobileOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    const isDropdownOpen = button.getAttribute("aria-expanded") === "true";
    const isMobileOpen = mobileButton.getAttribute("aria-expanded") === "true";

    if (e.key === "Escape") {
      if (isMobileOpen) {
        setMobileOpen(false);
        mobileButton.focus();
      } else if (isDropdownOpen) {
        setDropdownOpen(false);
        button.focus();
      }
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      setMobileOpen(false);
    }
    setDropdownOpen(false);
  });
</script>
