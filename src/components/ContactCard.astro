---
export interface Props {
  name: string;
  jobtitle?: string;
  email?: string;
  phone?: string;
}

const { name, jobtitle, email, phone } = Astro.props;
---

<div class="flex flex-col gap-2">
  <div class="flex flex-col gap-1 mt-2">
    <div class="mb-3">
      <h3 class="font-bold text-dark text-xl">{name}</h3>
      {jobtitle && <p class="text-dark-green font-semibold">{jobtitle}</p>}
    </div>
    {
      phone && (
        <a
          href={`tel:${phone}`}
          class=" text-dark hover:text-dark-green hover:underline"
        >
          {phone}
        </a>
      )
    }
    {
      email && (
        <a
          href={`mailto:${email}`}
          class=" text-dark hover:text-dark-green hover:underline"
        >
          {email}
        </a>
      )
    }
  </div>
</div>
