---
import { client } from "../lib/sanity";

const categories =
  await client.fetch(`*[_type == "category" && isHidden != true && defined(slug.current)]{
  title,
  "slug": slug.current
} | order(title asc)`);

const link = "hover:underline";
---

<footer
  class="relative flex flex-col gap-2 bg-dark text-white mt-25 overflow-hidden"
>
  <div
    class="absolute inset-0 opacity-10 md:opacity-15 z-0 w-full md:w-350 mx-auto shrink-0"
  >
    <svg
      class="h-150 w-150 text-accent absolute -top-20 md:-top-15 -left-20 scale-100 md:scale-110"
      fill="currentColor"
      aria-hidden="true"
      viewBox="0 0 365 216"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      xml:space="preserve"
      style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
      ><path
        d="M0,0l364.314,0l-364.222,215.769l-0.092,-215.769Zm2.501,2.5l0.089,208.883l352.599,-208.883l-352.688,-0Z"
      ></path></svg
    >
    <svg
      class="h-150 w-150 text-accent absolute -top-10 md:-top-20 -right-10 md:right-100 rotate-65 scale-110"
      fill="currentColor"
      aria-hidden="true"
      viewBox="0 0 365 216"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      xml:space="preserve"
      style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
      ><path
        d="M0,0l364.314,0l-364.222,215.769l-0.092,-215.769Zm2.501,2.5l0.089,208.883l352.599,-208.883l-352.688,-0Z"
      ></path></svg
    >
    <svg
      class="h-150 w-150 text-accent absolute top-100 md:-top-30 right-0 md:right-50 lg:right-0 scale-120 rotate-y-180 rotate-x-180"
      fill="currentColor"
      aria-hidden="true"
      viewBox="0 0 365 216"
      version="1.1"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      xml:space="preserve"
      style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
      ><path
        d="M0,0l364.314,0l-364.222,215.769l-0.092,-215.769Zm2.501,2.5l0.089,208.883l352.599,-208.883l-352.688,-0Z"
      ></path></svg
    >
  </div>

  <div class="h-3 bg-accent w-full"></div>
  <div
    class="relative z-10 flex flex-col md:flex-row justify-between items-start gap-10 mx-auto w-full max-w-350 py-5 md:py-15 px-8"
  >
    <div class="flex flex-col items-start gap-2 md:max-w-60 lg:max-w-90 w-full">
      <a href="/" class="font-heading text-[4rem] font-bold leading-tight"
        >Nordic Kiila</a
      >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <div class="mt-3">Sosiaalisen median kuvakkeet</div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 w-fit gap-8 md:gap-4 lg:gap-20">
      <div>
        <h2 class="font-bold text-md uppercase tracking-wider mb-3">
          Tuotteet
        </h2>
        <ul class="flex flex-col gap-2">
          <li class={`${link} hidden`}>
            <a href="/">Kaikki tuotteet</a>
          </li>
          {
            categories.map((cat: any) => (
              <li>
                <a
                  href={`/kategoria/${cat.slug}`}
                  class={link}
                  role="menuitem"
                  tabindex="-1"
                >
                  {cat.title}
                </a>
              </li>
            ))
          }
          <li class={link}><a href="#">Outlet-tuotteet</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-bold text-md uppercase tracking-wider mb-3">Meistä</h2>
        <ul class="flex flex-col gap-2">
          <li class={link}>
            <a href="/#suunnittelupalvelu">Suunnittelupalvelu</a>
          </li>
          <li class={link}><a href="/yhteystiedot">Yhteystiedot</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-bold text-md uppercase tracking-wider mb-3">Muut</h2>
        <ul class="flex flex-col gap-2">
          <li class={link}><a href="/">Evästeasetukset</a></li>
          <li class={link}><a href="/">Tietosuojalauseke</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div
    class="bg-accent p-3 w-full flex items-center justify-center text-black mt-4"
  >
    Copyright @ 2026 Nordic Kiila
  </div>
</footer>
